rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin auth check via Firestore document
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper to get the current user's document
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Checks if the user is banned and has active access (72-hour trial or subscription)
    // IMPORTANT: The 72-hour duration (259200000 ms) MUST match TRIAL_DURATION_MS in src/lib/constants.js
    function canWriteInvoice() {
      let userDoc = getUserDoc();
      let isBanned = userDoc != null && userDoc.data.get('banned', false) == true;
      let hasActiveAccess = userDoc != null && (
        (
          'createdAt' in userDoc.data && 
          request.time.toMillis() < (userDoc.data.createdAt.toMillis() + 259200000)
        ) 
        ||
        (
          'subscriptionUntil' in userDoc.data && 
          request.time.toMillis() < userDoc.data.subscriptionUntil.toMillis()
        )
      );
      return !isBanned && hasActiveAccess;
    }

    // Rate limiting stopgap: prevent invoice creation if lastInvoiceAt is within 2000ms
    function isRateLimited() {
      let userDoc = getUserDoc();
      return userDoc != null && 'lastInvoiceAt' in userDoc.data && 
             request.time.toMillis() < (userDoc.data.lastInvoiceAt.toMillis() + 2000);
    }

    // Hardcoded sum for up to 20 products since rules don't support loops
    function getProductTotal(data, index) {
      return data.products.size() > index ? (data.products[index].qty * data.products[index].price) : 0.0;
    }
    function calculateProductsSum(data) {
      return getProductTotal(data, 0) + getProductTotal(data, 1) + getProductTotal(data, 2) + getProductTotal(data, 3) + getProductTotal(data, 4) +
             getProductTotal(data, 5) + getProductTotal(data, 6) + getProductTotal(data, 7) + getProductTotal(data, 8) + getProductTotal(data, 9) +
             getProductTotal(data, 10) + getProductTotal(data, 11) + getProductTotal(data, 12) + getProductTotal(data, 13) + getProductTotal(data, 14) +
             getProductTotal(data, 15) + getProductTotal(data, 16) + getProductTotal(data, 17) + getProductTotal(data, 18) + getProductTotal(data, 19);
    }
    function isValidInvoiceMath(data) {
       let sum = calculateProductsSum(data);
       let discount = data.get('discountAmount', 0.0);
       let expectedTotal = sum - discount;
       return data.products.size() <= 20 &&
              data.total >= expectedTotal - 2.0 && data.total <= expectedTotal + 2.0;
    }

    // Global platform configuration (e.g., announcements)
    match /platformConfig/{document=**} {
      // Anyone logged in can read the config. Only the admin can write to it.
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // shopNames registry to enforce unique shop names
    match /shopNames/{shopNameId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // users/{uid} — shop owner profiles
    match /users/{userId} {
      // A shop owner can read only their own profile.
      // The admin can read every profile (for the admin panel).
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isAdmin());
      // A shop owner can write their own profile, but Admin can also write to ANY profile (to ban them).
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // users/{userId}/products — shop owner's inventory
      match /products/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // users/{userId}/paymentEvents — admin audit trail
      match /paymentEvents/{eventId} {
        allow read, write: if isAdmin();
      }
    }

    // invoices/{invoiceId}
    match /invoices/{invoiceId} {
      // Anyone can read a SINGLE invoice by its exact ID (this powers the
      // public wa.me link) but this does NOT allow listing/querying all
      // invoices.
      allow get: if true;

      // TRUST GAP: unit prices are still client-declared and not verified against the shop's actual product catalog — a shop owner could still write internally-consistent-but-fabricated prices into their own invoices. Closing this requires a Cloud Function with the Admin SDK reading live product prices server-side. Not implemented in this pass.
      // RATE LIMITING STOPGAP: timestamp check against lastInvoiceAt on the user doc. This is not a substitute for robust server-side rate limiting.
      allow create: if request.auth != null &&
                       request.resource.data.shopId == request.auth.uid &&
                       canWriteInvoice() &&
                       !isRateLimited() &&
                       request.resource.data.total >= 0 &&
                       isValidInvoiceMath(request.resource.data) &&
                       (request.resource.data.products.size() > 0 ? request.resource.data.total > 0 : true);

      // A shop owner can only list/query invoices that are their own.
      // The admin bypasses this entirely and can list all invoices.
      allow list: if request.auth != null &&
                     (isAdmin() || resource.data.shopId == request.auth.uid);

      allow delete: if request.auth != null &&
                                (isAdmin() || (resource.data.shopId == request.auth.uid && canWriteInvoice()));

      allow update: if request.auth != null &&
                        (isAdmin() || (
                          resource.data.shopId == request.auth.uid && 
                          canWriteInvoice() &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'amountPaid', 'updatedAt'])
                        ));
    }

    // purchaseInvoices/{purchaseInvoiceId}
    match /purchaseInvoices/{purchaseInvoiceId} {
      allow read, list: if request.auth != null &&
                            (isAdmin() || resource.data.shopId == request.auth.uid);
      // TRUST GAP: unit prices are still client-declared and not verified against the shop's actual product catalog — a shop owner could still write internally-consistent-but-fabricated prices into their own invoices. Closing this requires a Cloud Function with the Admin SDK reading live product prices server-side. Not implemented in this pass.
      // RATE LIMITING STOPGAP: timestamp check against lastInvoiceAt on the user doc. This is not a substitute for robust server-side rate limiting.
      allow create: if request.auth != null &&
                       request.resource.data.shopId == request.auth.uid &&
                       canWriteInvoice() &&
                       !isRateLimited() &&
                       request.resource.data.total >= 0 &&
                       isValidInvoiceMath(request.resource.data);
      // Immutable after creation (except by admin if ever needed, but spec says no)
      allow update, delete: if false;
    }
  }
}
